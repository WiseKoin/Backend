# Neon Local creates an ephemeral child branch from this parent.
NEON_API_KEY=neon_api_key
NEON_PROJECT_ID=project_id
PARENT_BRANCH_ID=branch_id
DELETE_BRANCH=true
NEON_DATABASE=neondb
NEON_LOCAL_PORT=5432

APP_PORT=8080
JPA_SHOW_SQL=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=wisekoin-backend@local
SENTRY_TRACES_SAMPLE_RATE=1.0
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000
VISION_LANGUAGE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent
GEMINI_FALLBACK_URL=
GEMINI_FALLBACK_MODEL=
AI_PROVIDER_CONNECT_TIMEOUT=5s
AI_PROVIDER_RESPONSE_TIMEOUT=30s
AI_PROVIDER_RETRY_MAX_ATTEMPTS=3
AI_PROVIDER_RETRY_INITIAL_BACKOFF=200ms
AI_PROVIDER_RETRY_MAX_BACKOFF=2s
AI_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
AI_PROVIDER_CIRCUIT_OPEN_DURATION=30s
AI_IMAGE_MAX_BYTES=5242880
AI_IMAGE_MAX_WIDTH=8192
AI_IMAGE_MAX_HEIGHT=8192
AI_IMAGE_MAX_PIXELS=20000000
AI_AUDIO_MAX_BYTES=5242880
AI_AUDIO_MAX_DURATION=60s
AI_INGESTION_PROCESSING_TIMEOUT=5m
AI_INGESTION_METADATA_RETENTION=30d
AI_INGESTION_CLEANUP_CRON=0 30 3 * * *
AI_DEFAULT_LOCALE=vi-VN
AI_RECEIPT_PROMPT_RESOURCE=classpath:ai/prompts/receipt-v2.txt
AI_RECEIPT_PROMPT_VERSION=receipt-v2
AI_VOICE_PROMPT_RESOURCE=classpath:ai/prompts/voice-v2.txt
AI_VOICE_PROMPT_VERSION=voice-v2
AI_CONFIDENCE_PROFILE=baseline-v1
AI_CONFIDENCE_CALIBRATED=false
AI_CONFIDENCE_HIGH_THRESHOLD=0.80
AI_CONFIDENCE_MEDIUM_THRESHOLD=0.55
APP_TIME_ZONE=Asia/Ho_Chi_Minh
FORWARD_HEADERS_STRATEGY=native
RECURRING_TRANSACTIONS_CRON=0 5 0 * * *
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AI_REQUESTS=10
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_API_REQUESTS=120
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=development@example.com
MAIL_PASSWORD=replace-me
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
OTP_FROM_EMAIL=development@example.com
OTP_EXPIRATION_SECONDS=600
OTP_VERIFICATION_EXPIRATION_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=3
OTP_MAX_ATTEMPTS=5
