# Neon Local creates an ephemeral child branch from this parent.
NEON_API_KEY=neon_api_key
NEON_PROJECT_ID=project_id
PARENT_BRANCH_ID=branch_id
DELETE_BRANCH=true
NEON_DATABASE=neondb
NEON_LOCAL_PORT=5432

APP_PORT=8080
JPA_SHOW_SQL=true
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000
VISION_LANGUAGE_API_KEY=
APP_TIME_ZONE=Asia/Ho_Chi_Minh
FORWARD_HEADERS_STRATEGY=native
RECURRING_TRANSACTIONS_CRON=0 5 0 * * *
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AI_REQUESTS=10
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_API_REQUESTS=120
