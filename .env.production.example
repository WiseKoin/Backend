DOCKER_IMAGE=dockerhub-user/wisekoin:latest
APP_PORT=8080

# Use the JDBC form of the connection URL shown by Neon.
DB_URL=jdbc:postgresql://ep-example.region.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=replace-me
JPA_DDL_AUTO=update

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000
VISION_LANGUAGE_API_KEY=replace-me
APP_TIME_ZONE=Asia/Ho_Chi_Minh
FORWARD_HEADERS_STRATEGY=native
RECURRING_TRANSACTIONS_CRON=0 5 0 * * *
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AI_REQUESTS=10
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_API_REQUESTS=120
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=replace-me
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
OTP_FROM_EMAIL=no-reply@example.com
OTP_EXPIRATION_SECONDS=600
OTP_VERIFICATION_EXPIRATION_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=3
OTP_MAX_ATTEMPTS=5
