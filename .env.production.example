DOCKER_IMAGE=dockerhub-user/wisekoin:latest
APP_PORT=8080

# Use the JDBC form of the connection URL shown by Neon.
DB_URL=jdbc:postgresql://ep-example.region.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=replace-me
JPA_DDL_AUTO=update

JWT_SECRET=replace-with-at-least-32-random-bytes
VISION_LANGUAGE_API_KEY=replace-me
